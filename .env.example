# Copy to .env (local) or set in your hosting provider's dashboard.
# Both values are on the app's Settings page in the Dev Dashboard / Partner Dashboard.
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret

# Optional: only needed if your store is NOT in the same organization as the app
# (client credentials grant unavailable). Paste an Admin API access token with write_orders.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx

# Optional
# PORT=3000
# SHOPIFY_API_VERSION=2026-10
# METAFIELD_NAMESPACE=$app
# METAFIELD_KEY=random_text
